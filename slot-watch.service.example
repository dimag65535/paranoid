[Unit]
Description=Private booking slot Telegram watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/slot-watch
EnvironmentFile=/opt/slot-watch/.env
ExecStart=/usr/bin/python3 -m slot_watch.app
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
